APP_ENV=development
LOG_LEVEL=INFO
# Structured one-JSON-line-per-event output for agentic log readers.
# Comment out (or set to "text") for human-readable single-line dev TTY output.
LOG_FORMAT=json

API_PORT=8000
WEB_UI_PORT=8001
BOT_GATEWAY_PORT=8002
INGEST_WORKER_PORT=8003
SCHEDULER_PORT=8004
USER_GATEWAY_PORT=8005
USER_GATEWAY_BASE_URL=http://user_gateway:8005
OPERATOR_SESSIONS_DIR=.data/operator_sessions

QDRANT_URL=http://qdrant:6333
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/semantaix
PERSISTENCE_DB_PATH=.data/semantaix_story1.db
TELEGRAM_BOT_TOKEN=replace-me
# Cloud Telegram Bot API by default. To self-host (lifts the 20 MB getFile
# cap to 2 GB), spin up the `telegram_bot_api` service via
# `docker compose --profile local-bot-api up`, fill in TELEGRAM_API_ID and
# TELEGRAM_API_HASH from https://my.telegram.org, set
# TELEGRAM_BOT_API_BASE_URL=http://telegram_bot_api:8081 and
# TELEGRAM_BOT_API_LOCAL_MODE=true, and raise OPERATOR_UPLOAD_MAX_BYTES.
# IMPORTANT one-time migration: run
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/logOut"
# before the first start so the bot is no longer tied to the cloud server.
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_API_LOCAL_MODE=false
TELEGRAM_BOT_API_FILE_STORAGE_ROOT=/var/lib/telegram-bot-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Epic 15 — Telegram user account gateway (MTProto via Telethon).
TG_USER_SESSION_PATH=.data/user_gateway.session
USER_GATEWAY_BASE_URL=http://user_gateway:8005
OPERATOR_SESSIONS_DIR=.data/operator_sessions
TELEGRAM_ALERT_USERNAME=@ajdevy
TELEGRAM_ALERT_CHAT_ID=
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_GROUNDING_MODEL=google/gemini-2.5-flash-lite
INCIDENT_DB_PATH=.data/semantaix_incidents.db
INCIDENT_DEDUP_WINDOW_SECONDS=300
TELEGRAM_ALERT_DEBOUNCE_SECONDS=300
HITL_TICKET_DB_PATH=.data/semantaix_hitl.db
HITL_CONFIG_ADMIN_USERNAME=@ajdevy
INBOUND_ACK_MESSAGE=Минутку, уточню и вернусь с ответом.
# Story 12.12 — scoping fields a booking must collect (canonical order). Default
# drops tour-only difficulty/drivers; tour projects re-add them via runtime config.
SCOPING_REQUIRED_FIELDS=dates,headcount,vehicle_count
# Story 12.13 — send the "минуточку" interim ack only if the answer takes longer.
INBOUND_INTERIM_DELAY_SECONDS=8.0
# Story 12.103 — per-customer message size cap and rate limit.
INBOUND_MAX_MESSAGE_CHARS=1000
INBOUND_RATE_LIMIT_MESSAGES=10
INBOUND_RATE_LIMIT_WINDOW_SECONDS=300
INBOUND_RATE_LIMIT_DB_PATH=.data/semantaix_rate_limits.db
BOT_PERSONA_FIRST_NAME=Semantaix
BOT_PERSONA_LAST_NAME=
TELEGRAM_PLATFORM_BOT_USERNAME=@semantaix_bot
BOT_TELEGRAM_DESCRIPTION=Semantaix — платформа для операторов. Новым операторам: отправьте /register для подачи заявки.
BOT_TELEGRAM_SHORT_DESCRIPTION=Semantaix — регистрация и настройка операторов.
SALES_PERSONA_FIRST_NAME=Анна
SALES_PERSONA_LAST_NAME=Иванова
API_INTERNAL_BASE_URL=http://api:8000
RAG_GROUNDING_SCORE_THRESHOLD=0.6
DEFAULT_LANGUAGE=ru
DEFAULT_COUNTRY_CODE=RU
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LOCATION=Moscow
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com
RAG_DB_PATH=.data/semantaix_rag.db
KNOWLEDGE_DB_PATH=.data/semantaix_knowledge.db
ANSWER_TRACE_DB_PATH=.data/semantaix_answer_traces.db
ANSWER_TRACE_SNIPPET_MAX_CHARS=240
NL_OPS_ENABLED=true
NL_OPS_DB_PATH=.data/semantaix_nl_ops.db
NL_OPS_ADMIN_USER_IDS=
NL_OPS_DEFAULT_TENANT_ID=default
BACKUP_DB_PATH=.data/semantaix_backups.db
BACKUP_ARCHIVE_DIR=.data/backups
BACKUP_SOURCE_PATHS=.data/semantaix_story1.db,.data/semantaix_incidents.db,.data/semantaix_hitl.db,.data/semantaix_rag.db,.data/semantaix_knowledge.db
OPERATOR_KB_SESSION_TTL_SECONDS=600
# Default = 20 MB (cloud Bot API hard cap on getFile). Raise to 150 MB
# (157286400) when running the local Bot API server.
OPERATOR_UPLOAD_MAX_BYTES=20971520

# Offline message backlog recovery. When bot_gateway recovers from downtime,
# Telegram redelivers the queued customer messages. A message whose send time
# is older than STALE_SECONDS is treated as backlog and buffered per chat; the
# debounced flush answers only the latest, pulling up to MAX_CONTEXT_MESSAGES
# preceding ones in as context when the latest is shorter than MIN_CONTEXT_CHARS
# (or a known short context cue).
OFFLINE_BACKLOG_STALE_SECONDS=30
OFFLINE_BACKLOG_DEBOUNCE_SECONDS=5
OFFLINE_BACKLOG_SETTLING_CAP_SECONDS=30
OFFLINE_BACKLOG_POLL_INTERVAL_SECONDS=0.5
OFFLINE_BACKLOG_MIN_CONTEXT_CHARS=12
OFFLINE_BACKLOG_MAX_CONTEXT_MESSAGES=3
# Backoff delays (s) for retrying a failed inbound forward before it strands in
# the pending-forward outbox — survives a transient api outage (e.g. the api
# recreating during a rebuild) without dropping the customer's message.
PENDING_FORWARD_RETRY_DELAYS_SECONDS=2,5,10

# Epic 11 — Google Calendar availability (read-only first).
# Calendar is OPT-IN per project and disabled by default.
CALENDAR_DB_PATH=.data/semantaix_calendar.db
# Fernet key for encrypting per-operator refresh tokens at rest (env only,
# never committed, never logged). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
CALENDAR_OAUTH_STATE_TTL_SECONDS=300

# Epic 12 — Sales conversation persona.
# Stores per-chat conversation state, the services catalog, client
# materials registry, and the follow-up queue. The DB is created
# idempotently on first api startup; the SalesPersonaAnswerer stays
# dormant until either an existing state row drives it or a sales-intent
# inbound triggers the greeting stage.
SALES_DB_PATH=.data/semantaix_sales.db

# Epic 14: usage / token / cost monitoring telemetry DB
USAGE_DB_PATH=.data/semantaix_usage.db
USAGE_QUEUE_MAXSIZE=1024
USAGE_DAILY_ROLLUP_HOUR_UTC=0
USAGE_RAW_RETENTION_DAYS=30
USAGE_ROLLUP_BATCH_SIZE=10000
