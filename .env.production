# Production defaults (non-secret). Secrets are injected at deploy time from
# GitHub Actions repository secrets via scripts/render_production_env.py.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

API_PORT=8000
WEB_UI_PORT=8001
BOT_GATEWAY_PORT=8002
INGEST_WORKER_PORT=8003
SCHEDULER_PORT=8004
USER_GATEWAY_PORT=8005
USER_GATEWAY_BASE_URL=http://user_gateway:8005
OPERATOR_SESSIONS_DIR=.data/operator_sessions

QDRANT_URL=http://qdrant:6333
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/semantaix
PERSISTENCE_DB_PATH=.data/semantaix_story1.db

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_API_LOCAL_MODE=false
TELEGRAM_BOT_API_FILE_STORAGE_ROOT=/var/lib/telegram-bot-api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TG_USER_SESSION_PATH=.data/user_gateway.session

TELEGRAM_ALERT_USERNAME=@ajdevy
TELEGRAM_ALERT_CHAT_ID=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_GROUNDING_MODEL=google/gemini-2.5-flash-lite

INCIDENT_DB_PATH=.data/semantaix_incidents.db
INCIDENT_DEDUP_WINDOW_SECONDS=300
TELEGRAM_ALERT_DEBOUNCE_SECONDS=300
HITL_TICKET_DB_PATH=.data/semantaix_hitl.db
HITL_CONFIG_ADMIN_USERNAME=@ajdevy
INBOUND_ACK_MESSAGE=Минутку, уточню и вернусь с ответом.
SCOPING_REQUIRED_FIELDS=dates,headcount,vehicle_count
INBOUND_INTERIM_DELAY_SECONDS=8.0
INBOUND_MAX_MESSAGE_CHARS=1000
INBOUND_RATE_LIMIT_MESSAGES=10
INBOUND_RATE_LIMIT_WINDOW_SECONDS=300
INBOUND_RATE_LIMIT_DB_PATH=.data/semantaix_rate_limits.db

BOT_PERSONA_FIRST_NAME=Semantaix
BOT_PERSONA_LAST_NAME=
TELEGRAM_PLATFORM_BOT_USERNAME=@semantaix_bot
BOT_TELEGRAM_DESCRIPTION=Semantaix — платформа для операторов. Новым операторам: отправьте /register для подачи заявки.
BOT_TELEGRAM_SHORT_DESCRIPTION=Semantaix — регистрация и настройка операторов.
SALES_PERSONA_FIRST_NAME=Анна
SALES_PERSONA_LAST_NAME=Иванова
API_INTERNAL_BASE_URL=http://api:8000

INTERNAL_SERVICE_TOKEN=
WEB_UI_BASE_URL=https://semantaix.flexsentlabs.com/admin
GOOGLE_OAUTH_REDIRECT_URI=https://semantaix.flexsentlabs.com/api/calendar/oauth/callback
WEB_UI_ADMIN_COOKIE_SECURE=true

RAG_GROUNDING_SCORE_THRESHOLD=0.6
DEFAULT_LANGUAGE=ru
DEFAULT_COUNTRY_CODE=RU
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LOCATION=Moscow
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com
RAG_DB_PATH=.data/semantaix_rag.db
KNOWLEDGE_DB_PATH=.data/semantaix_knowledge.db
ANSWER_TRACE_DB_PATH=.data/semantaix_answer_traces.db
ANSWER_TRACE_SNIPPET_MAX_CHARS=240
NL_OPS_ENABLED=true
NL_OPS_DB_PATH=.data/semantaix_nl_ops.db
NL_OPS_ADMIN_USER_IDS=
NL_OPS_DEFAULT_TENANT_ID=default
BACKUP_DB_PATH=.data/semantaix_backups.db
BACKUP_ARCHIVE_DIR=.data/backups
BACKUP_SOURCE_PATHS=.data/semantaix_story1.db,.data/semantaix_incidents.db,.data/semantaix_hitl.db,.data/semantaix_rag.db,.data/semantaix_knowledge.db
OPERATOR_KB_SESSION_TTL_SECONDS=600
OPERATOR_UPLOAD_MAX_BYTES=20971520

OFFLINE_BACKLOG_STALE_SECONDS=30
OFFLINE_BACKLOG_DEBOUNCE_SECONDS=5
OFFLINE_BACKLOG_SETTLING_CAP_SECONDS=30
OFFLINE_BACKLOG_POLL_INTERVAL_SECONDS=0.5
OFFLINE_BACKLOG_MIN_CONTEXT_CHARS=12
OFFLINE_BACKLOG_MAX_CONTEXT_MESSAGES=3
PENDING_FORWARD_RETRY_DELAYS_SECONDS=2,5,10

CALENDAR_DB_PATH=.data/semantaix_calendar.db
CALENDAR_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDAR_OAUTH_STATE_TTL_SECONDS=300

SALES_DB_PATH=.data/semantaix_sales.db
USAGE_DB_PATH=.data/semantaix_usage.db
USAGE_QUEUE_MAXSIZE=1024
USAGE_DAILY_ROLLUP_HOUR_UTC=0
USAGE_RAW_RETENTION_DAYS=30
USAGE_ROLLUP_BATCH_SIZE=10000
